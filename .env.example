# Copy to .env and fill in from your Supabase project settings (API tab).
# Both are safe to ship in the client bundle: the anon key is protected by RLS.
EXPO_PUBLIC_SUPABASE_URL=https://ckuyggihxeedkovswjhj.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_coNqIfqnS-Z5OfP-TrL4ag_dj5OordA

# Optional: needed only for `expo-notifications` push tokens on a dev build.
EXPO_PUBLIC_EAS_PROJECT_ID=

# Optional: the deployed web origin, e.g. https://betta.your-name.workers.dev
# Used to build shareable invite links on a phone, where there is no
# `window.location` to read. Without it, links fall back to `betta://`,
# which only works for people who already have the app.
EXPO_PUBLIC_WEB_ORIGIN=

# Required before submitting to the App Store. Guideline 1.2 asks a
# user-generated-content app for published contact information, and it means a
# real address: this is what the Support page, the About section on Profile and
# the legal pages print. Left unset, the app renders no contact row at all
# rather than offering to write to a placeholder.
EXPO_PUBLIC_SUPPORT_EMAIL=

# Optional: where the generated legal pages are hosted, if that is not the same
# origin as the web build. Defaults to EXPO_PUBLIC_WEB_ORIGIN, because
# `npm run build:web` writes them into the export — so if the web build is
# deployed anywhere, the privacy policy and support URLs App Store Connect asks
# for already exist at <origin>/legal/privacy.html and /legal/support.html.
EXPO_PUBLIC_LEGAL_ORIGIN=
