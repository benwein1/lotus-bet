{
  // Cloudflare Workers, serving the exported web build as static assets.
  //
  // There is no `main` here on purpose: with only `assets`, this is a
  // static-asset Worker with no server code at all. Nothing in Betta needs
  // a server — Supabase is the backend, and the web build is a plain SPA.
  //
  //   npm run build:web   → writes ./dist
  //   npx wrangler deploy → uploads it
  //
  // Both commands are what the Cloudflare build is configured to run.
  "$schema": "node_modules/wrangler/config-schema.json",

  // This name is what a `wrangler deploy` run from a laptop creates, and it is
  // where `*.workers.dev` gets its first label from. It is NOT what renames an
  // existing deployment: Workers Builds pushes to the service the Git
  // integration is bound to, so changing this line alone left the live site on
  // `lotus-bet.weinsteinben2.workers.dev` after the app became Betta. A rename
  // is a dashboard action — a new Worker with this name, the repo connected to
  // it, the old one deleted — and `EXPO_PUBLIC_WEB_ORIGIN` in `eas.json` has
  // to be the origin that action actually produces.
  "name": "betta",
  "compatibility_date": "2026-09-09",
  "assets": {
    "directory": "./dist",

    // The app is one `index.html` (`output: "single"` in app.json), so every
    // route has to resolve to it. Without this, `/group/<id>` 404s on refresh
    // and every shared link is broken — the same reason the local test server
    // is run with `-P`. "single-page-application" serves index.html with a 200
    // for anything that is not a real file.
    "not_found_handling": "single-page-application"
  }
}
